# =============================================================================
# CORTEX — .gitignore
# Regla: NUNCA datos reales de pacientes, NUNCA credenciales, NUNCA outputs.
# Solo código, tests, docs, config y fixtures sintéticos.
# =============================================================================

# ─── Credenciales (CRÍTICO) ───────────────────────────────────────────────
keys/
token.json
token.pickle
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
client_secret*.json
service_account*.json
credentials.json

# ─── Datos y outputs (regenerables, no se versionan) ──────────────────────
data/
logs/
*.log

# ─── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

.venv/
venv/
env/
ENV/

build/
dist/
*.egg-info/
.eggs/

# ─── Testing y tooling ────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ─── Jupyter ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Modelos LLM y caches (si los usás en Fase 2) ─────────────────────────
models/
*.gguf
*.safetensors
*.onnx
.cache/
.ollama/

# ─── Editores y OS ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Documentos clínicos (bloqueo por extensión) ─────────────────────────
# Aunque el proyecto no los usa todavía, bloqueamos por las dudas.
# Si en el futuro necesitás versionar un .docx (ej. un manual), agregá
# una excepción explícita con !.
*.docx
*.doc
*.rtf
*.odt
*.dcm
*.dicom
*.ima
DICOMDIR

# ─── Datos clínicos en formatos tabulares (bloqueo por extensión) ────────
# Bloqueamos .xlsx/.csv/.parquet fuera de data/ (data/ ya está ignorado).
# Si en el futuro necesitás un fixture .csv/.json, agregá la excepción.
*.xlsx
*.xlsm
*.xls
*.ods
*.parquet
*.feather

# ─── Base de datos locales (por si se agregan en Fase 2) ─────────────────
*.sqlite
*.sqlite3
*.db

# ─── Excepciones explícitas para fixtures sintéticos ─────────────────────
# Los fixtures son código (Python) y JSON determinista. Se versionan.
!tests/fixtures/**/*.json
!tests/fixtures/**/*.py